<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-4 py-10 text-center">
    <p class="text-xs font-extrabold uppercase tracking-widest text-ink-soft">
      {gettext("Media tracker")}
    </p>
    <h1 class="font-display text-4xl font-bold text-ink">
      {gettext("Light, quiet, and let the posters do the talking.")}
    </h1>
    <p class="mx-auto max-w-md text-ink-soft">
      {gettext("Track what your household watches, without fighting a form.")}
    </p>
  </div>
</Layouts.app>
