<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-4 py-10 text-center">
    <.section_label>{dgettext("home", "Media tracker")}</.section_label>
    <h1 class="font-display text-4xl font-bold text-ink">
      {dgettext("home", "Light, quiet, and let the posters do the talking.")}
    </h1>
    <p class="mx-auto max-w-md text-ink-soft">
      {dgettext("home", "Track what your household watches, without fighting a form.")}
    </p>
    <div :if={@current_scope}>
      <.button navigate={~p"/search"} variant="primary">{dgettext("home", "Find a movie")}</.button>
    </div>
  </div>
</Layouts.app>
